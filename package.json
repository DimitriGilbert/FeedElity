{
  "name": "FeedElity",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@orpc/server": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "better-auth": "1.6.9",
      "@orpc/client": "^1.13.14",
      "drizzle-orm": "^0.45.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "dev:web": "turbo -F web dev",
    "dev:desktop": "bun --filter desktop dev:hmr",
    "build:desktop": "bun --filter desktop build:stable",
    "build:desktop:canary": "bun --filter desktop build:canary",
    "build:desktop:linux": "bun scripts/build-desktop-release.ts --platform linux",
    "build:desktop:mac": "bun scripts/build-desktop-release.ts --platform macos",
    "build:desktop:windows": "bun scripts/build-desktop-release.ts --platform windows",
    "publish:desktop": "./scripts/publish-desktop-release.sh",
    "dev:server": "turbo -F server dev",
    "dev:docs": "turbo -F docs dev",
    "db:push": "turbo -F @FeedElity/db db:push",
    "db:studio": "turbo -F @FeedElity/db db:studio",
    "db:generate": "turbo -F @FeedElity/db db:generate",
    "db:migrate": "turbo -F @FeedElity/db db:migrate",
    "db:local": "turbo -F @FeedElity/db db:local",
    "deploy:docs": "bun run scripts/deploy-pages.ts"
  },
  "dependencies": {
    "@FeedElity/db": "workspace:*",
    "@FeedElity/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@FeedElity/config": "workspace:*",
    "@types/bun": "catalog:",
    "gh-pages": "^6.3.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.0"
}
