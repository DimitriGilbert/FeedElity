# FeedElity compose configuration. Copy this file to the repo root as `.env`
# and fill in the values for your host, then `docker compose up -d --build`.
#
# The compose file reads these three variables from ./.env (repo root).
# If you don't create ./.env, `docker compose` leaves them empty and the server
# will fail to start (BETTER_AUTH_SECRET and BETTER_AUTH_URL are required).

# The full public URL browsers use to reach the web app, including scheme and
# port. better-auth uses this as its base URL and for cookie/CORS decisions.
# For local host access:   http://localhost:31000
# For LAN access:          http://192.168.1.41:31000
FEEDELITY_PUBLIC_URL=http://localhost:31000

# Comma-separated list of origins allowed to call the API (CORS + better-auth
# trusted origins). Always include the web app origin. The server origin is
# optional but harmless to add.
FEEDELITY_CORS_ORIGIN=http://localhost:31000,http://192.168.1.41:31000

# A random string of at least 32 characters used to sign auth tokens/cookies.
# Generate one with, for example:  openssl rand -base64 48
# Keep this stable: changing it logs everyone out and invalidates sessions.
FEEDELITY_AUTH_SECRET=replace-with-a-random-32-plus-char-secret-string
