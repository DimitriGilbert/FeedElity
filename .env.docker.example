RUNTIME_MODE=production
DATABASE_URL=http://db:8080
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-random-string
BETTER_AUTH_URL=http://localhost
CORS_ORIGIN=http://localhost
PORT=3002
NODE_ENV=production

# For libSQL container (used when running with --profile local-db)
# DATABASE_URL=http://db:8080

# For external database (Turso cloud, etc.)
# DATABASE_URL=libsql://your-db-name-your-org.turso.io?authToken=your-token

# Web server port (default 80)
# WEB_PORT=80
